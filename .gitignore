# ==============================================================================
# .gitignore for Terraform & Python Projects
# ==============================================================================

# ------------------------------------------------------------------------------
# Terraform / OpenTofu
# ------------------------------------------------------------------------------
# Local .terraform directories containing provider binaries and module sources
**/.terraform/

# Terraform state files contain sensitive data (passwords, private keys, secrets)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash logs
crash.log
crash.*.log

# Exclude sensitive var files containing credentials/secrets
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/

# ------------------------------------------------------------------------------
# Testing & Code Quality Tools
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# Local Execution Flags & Logs
# ------------------------------------------------------------------------------
.validate_trigger
.validation_done
*.log

# ------------------------------------------------------------------------------
# OS & IDE Generated Files
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
